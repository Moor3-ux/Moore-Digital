# MDS Control Panel — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
#
# Leave VITE_MDS_API_URL empty to run in DEMO MODE (mock data, no AWS).

# API Gateway URL output by infra/setup.sh
VITE_MDS_API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com

# Must match PANEL_KEY Lambda environment variable
VITE_MDS_PANEL_KEY=your-secret-panel-key
